# macOS Finder metadata, creeps into every folder.
.DS_Store

# Go build output and test caches stay out of git.
/givens
*.test
*.out
.claude/settings.local.json

# SwiftPM build output for the archived macOS app.
_archive/macos/.build/
_archive/macos/.swiftpm/

# txtodo's local daemon state (op log, device keys, token hashes); todo.txt and tasks/ are the backlog.
.txtodo/
# Claude Code's per-machine lock files.
.claude/*.lock

# The sample shop's test runner, installed by scripts/runner.sh.
/.cache/

# Givens.app, built by the archived _archive/scripts/build-app.sh.
/build/
